# LLM Provider Selection
# Options: "groq" (free) or "openai" (paid)
LLM_PROVIDER=groq

# Groq API Key (Free tier available)
# Get it from: https://console.groq.com
# Sign up and create API key (free tier)
GROQ_API_KEY=your_groq_api_key_here

# OpenAI API Key (Paid)
# Get it from: https://platform.openai.com/api-keys
cd "e:\projects\Nl2SQL agent"

# Create .env file with Groq (FREE)
cat > .env << EOF
LLM_PROVIDER=groq
GROQ_API_KEY=your_actual_groq_key_here
API_HOST=localhost
API_PORT=8000
ENVIRONMENT=development
DEBUG=True
EOF# Requires credit card and payment setup
OPENAI_API_KEY=your_openai_api_key_here

# FastAPI Configuration
API_HOST=localhost
API_PORT=8000

# Environment
ENVIRONMENT=development
DEBUG=True
